# Python environments
.venv/
venv/
__pycache__/
*.py[cod]

# Test and lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local secrets and environment files
.env
.env.*

# Raw and processed datasets
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Benchmark B - local experiments only
data/processed/benchmark_b/
reports/benchmark_b/

# Model artifacts - exclude everything by default
artifacts/*
!artifacts/training/
artifacts/training/*
!artifacts/training/training_history.json

# Exclude model weights and checkpoints
*.pt
*.pth
*.safetensors
*.bin

# Notebook temporary files
.ipynb_checkpoints/

# Experiment tracking
wandb/

# Generated package metadata
*.egg-info/
build/
dist/

# Intermediate local audit reports
reports/_local/

# Local tests - retain locally, do not publish
tests/

# Row-level evaluation outputs
reports/benchmark_a/baseline_error_analysis.csv
reports/benchmark_a/fine_tuned_error_analysis.csv

# Detailed intermediate similarity audit
reports/dataset_audit/split_similarity_audit.csv
